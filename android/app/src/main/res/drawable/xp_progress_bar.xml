<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="2dp" />
            <solid android:color="#1A00D4FF" />
            <stroke android:width="1dp" android:color="#4D00D4FF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="2dp" />
                <gradient
                    android:startColor="#8000D4FF"
                    android:endColor="#FF8CE6FF"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
